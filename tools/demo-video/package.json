{
  "name": "@saude-territorial/demo-video",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "install-browser": "playwright install chromium",
    "preview": "tsx src/preview.ts",
    "record": "tsx src/record.ts",
    "render": "remotion render src/index.ts DemoVideo output/demo.mp4",
    "reset-data": "cd ../.. && PGLITE_DATA_DIR=.data/demo-video pnpm db:reset && PGLITE_DATA_DIR=.data/demo-video pnpm db:seed:user",
    "smoke": "tsx src/smoke.ts",
    "studio": "remotion studio src/index.ts --no-open",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/media": "4.0.526",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.526",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.526",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
