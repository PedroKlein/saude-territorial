{
  "name": "saude-territorial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && set -a && . ./.env.local && set +a && drizzle-kit push",
    "db:migrate": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && set -a && . ./.env.local && set +a && drizzle-kit migrate",
    "db:studio": "set -a && . ./.env.local && set +a && drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && SEED_SYNTHETIC=1 tsx --env-file=.env.local scripts/seed-patients.ts",
    "db:seed:emit": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && SEED_SYNTHETIC=1 tsx --env-file=.env.local scripts/seed-patients.ts --emit-sql",
    "db:seed:user": "tsx --env-file=.env.local scripts/seed-dev-user.ts"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "better-auth": "latest",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "react-imask": "^7.6.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "latest",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "postcss": "^8.0.0",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
