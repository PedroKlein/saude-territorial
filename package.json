{
  "name": "saude-territorial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && set -a && . ./.env.local && set +a && drizzle-kit push",
    "db:migrate": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && set -a && . ./.env.local && set +a && drizzle-kit migrate",
    "db:studio": "set -a && . ./.env.local && set +a && drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && SEED_SYNTHETIC=1 tsx --env-file=.env.local scripts/seed-patients.ts",
    "db:seed:emit": "tsx --env-file=.env.local scripts/verify-non-prod-db.ts && SEED_SYNTHETIC=1 tsx --env-file=.env.local scripts/seed-patients.ts --emit-sql"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.2",
    "@tanstack/react-query": "^5.0.0",
    "@types/leaflet": "^1.9.21",
    "better-auth": "latest",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "next": "latest",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "zod": "latest",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "postcss": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
