# Google OAuth (identity only — no Sheets/Drive scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (source of truth via Drizzle; auth boundary via @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Drizzle DB connection (direct Postgres, added in pivot execution)
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
