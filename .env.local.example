# Google OAuth (identity only — no Sheets/Drive scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (data plane — direct Postgres via Drizzle; source of truth per ADR-001)
# Required for the Next.js app runtime AND for the pnpm db:* scripts
# (db:generate, db:push, db:migrate, db:seed, db:seed:emit).
# Prefer the Transaction pooler URL at port 6543 — works with postgres-js
# `prepare: false` (see src/db/client.ts). Copy from
# Supabase Dashboard → Connect → Transaction pooler.
DATABASE_URL=

# Supabase (identity / API keys — server-side scripts use SECRET; browser uses PUBLISHABLE)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# service_role: Dashboard → Project Settings → API → "service_role" → Reveal.
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
